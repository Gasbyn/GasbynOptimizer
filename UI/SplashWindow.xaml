<Window x:Class="GasbynOptimizer.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gasbyn Optimizer" Width="460" Height="300"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" ShowInTaskbar="True">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" CornerRadius="16">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
            <Image Source="/Logo.png" Height="84" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="GASBYN OPTIMIZER" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Ellipse x:Name="Spinner" Width="24" Height="24" Stroke="{StaticResource OrangeBrush}" StrokeThickness="3"
                     StrokeDashArray="6 13" StrokeDashCap="Round" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="Status" Text="Kontroluji aktualizace…" Foreground="{StaticResource MutedBrush}"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,14"/>
            <Border Height="6" CornerRadius="3" Background="{StaticResource Panel2Brush}" ClipToBounds="True">
                <Border x:Name="Bar" RenderTransformOrigin="0,0.5" CornerRadius="3" Background="{StaticResource OrangeBrush}" HorizontalAlignment="Stretch">
                    <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Border>
            <TextBlock x:Name="Counter" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
