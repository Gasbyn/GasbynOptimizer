<Window x:Class="GasbynOptimizer.UI.UpdateLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gasbyn Optimizer – Update log" Width="600" Height="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" CornerRadius="16" Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" MouseLeftButtonDown="Drag">
                <Image Source="/Logo.png" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Update log" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="Subtitle" Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <StackPanel x:Name="Content"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <CheckBox x:Name="ReceiveCheck" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" Click="Receive_Click"
                          Content="Dostávat Update log po každé aktualizaci"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Content="Zavřít" Click="Close_Click" Padding="22,8"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
