<Window x:Class="GasbynOptimizer.UI.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gasbyn Optimizer – Podmínky použití" Width="640" Height="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" CornerRadius="16" Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" MouseLeftButtonDown="Drag">
                <Image Source="/Logo.png" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Podmínky použití" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="Subtitle" Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                               Text="Před prvním použitím si prosím přečti tyto podmínky."/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <TextBlock x:Name="TermsText" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource TextBrush}"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="ServerButton" Style="{StaticResource GhostButton}" Content="Discord server (podpora)" Click="Server_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ChatButton" Style="{StaticResource GhostButton}" Content="Chat pro hlášení problémů" Click="Chat_Click"/>
                </StackPanel>
                <CheckBox x:Name="AgreeCheck" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" Click="Agree_Click"
                          Content="Přečetl(a) jsem podmínky, rozumím jim a souhlasím s nimi."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DeclineButton" Style="{StaticResource GhostButton}" Content="Nesouhlasím (ukončit)" Click="Decline_Click" Margin="0,0,8,0"/>
                    <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" Content="Souhlasím a pokračovat" Click="Accept_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
