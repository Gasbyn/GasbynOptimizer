<Window x:Class="GasbynOptimizer.UI.OptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Gasbyn Optimizer" Width="1120" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Logo.png"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Karta jedné optimalizace -->
        <DataTemplate x:Key="TweakTemplate">
            <Border x:Name="Card" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="RecommendedBadge" Visibility="Collapsed" Background="{StaticResource OrangeSoftBrush}"
                                    CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DOPORUČENO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OrangeBrush}"/>
                            </Border>
                            <Border x:Name="NewBadge" Visibility="Collapsed" Background="#10281E"
                                    CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="NOVÉ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                            </Border>
                            <Border x:Name="ExperimentalBadge" Visibility="Collapsed" Background="#2B2210"
                                    CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="EXPERIMENTÁLNÍ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                            </Border>
                            <Border x:Name="UnsupportedBadge" Visibility="Collapsed" Background="#2A1414"
                                    CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="NEPODPOROVANÉ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"/>
                        <TextBlock x:Name="UnsupportedText" Text="{Binding UnsupportedText}" Visibility="Collapsed"
                                   Foreground="{StaticResource RedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock x:Name="UnavailableLabel" Text="{Binding UnavailableText}" Visibility="Collapsed"
                                   Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock x:Name="NoteText" Text="{Binding Note}" Visibility="Collapsed"
                                   Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" Visibility="Collapsed"
                                   Foreground="{StaticResource GreenBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="76">
                        <TextBlock x:Name="StateLabel" Text="{Binding StateText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   FontFamily="Segoe UI, Segoe UI Emoji"
                                   HorizontalAlignment="Right" Margin="0,0,0,5"/>
                        <Button x:Name="SwitchBtn" Style="{StaticResource SwitchButton}" HorizontalAlignment="Right"
                                IsEnabled="{Binding CanToggle}" Click="Toggle_Click"/>
                        <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" HorizontalAlignment="Right"
                                Padding="16,7" Content="{Binding ApplyText}"
                                IsEnabled="{Binding CanToggle}" Click="Toggle_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                    <Setter TargetName="RecommendedBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="NewBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExperimental}" Value="True">
                    <Setter TargetName="ExperimentalBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowUnsupportedBadge}" Value="True">
                    <Setter TargetName="UnsupportedBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                    <Setter TargetName="UnsupportedText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowLock}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowUnavailable}" Value="True">
                    <Setter TargetName="UnavailableLabel" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsApplyOnly}" Value="True">
                    <Setter TargetName="SwitchBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ApplyBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNote}" Value="True">
                    <Setter TargetName="NoteText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasStatus}" Value="True">
                    <Setter TargetName="StatusText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource RedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Řádek seznamu bez výběru a zvýraznění -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <Border x:Name="WindowRoot" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Vlastní horní lišta okna -->
        <Grid Grid.Row="0" Background="#0F1115">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="/Logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="GASBYN OPTIMIZER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleButton}" Click="Minimize_Click" ToolTip="Minimalizovat">
                    <Path Data="M0,5 L10,5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                </Button>
                <Button Style="{StaticResource TitleButton}" Click="Maximize_Click" ToolTip="Maximalizovat">
                    <Grid Width="10" Height="10">
                        <Path x:Name="MaxIcon" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                        <Path x:Name="RestoreIcon" Data="M2.5,2.5 L2.5,0.5 L9.5,0.5 L9.5,7.5 L7.5,7.5 M0.5,2.5 L7.5,2.5 L7.5,9.5 L0.5,9.5 Z" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" SnapsToDevicePixels="True" Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource CloseTitleButton}" Click="Close_Click" ToolTip="Zavřít">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Obsah okna -->
        <Grid Grid.Row="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Postranní panel -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,22,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <Image Source="/Logo.png" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="GASBYN" FontSize="20" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock Text="OPTIMIZER" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OrangeBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
                        <StackPanel x:Name="NavPanel" Margin="0,0,6,0"/>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </Grid>
            </Border>

            <!-- Obsah -->
            <Grid Grid.Column="1">

                <!-- Stránka: Optimalizace -->
                <Grid x:Name="PageTweaks" Margin="28,24,22,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="PageTitle" Text="Všechny optimalizace" FontSize="24" FontWeight="Bold"/>
                            <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SystemText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="Vrátit vše" Click="RevertAll_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Zapnout doporučené" Click="ApplyRecommended_Click"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,16,0,12">
                        <Border Width="380" HorizontalAlignment="Left" Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                         CaretBrush="{StaticResource TextBrush}" FontSize="13" Padding="14,9" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="Hledat optimalizace…" Foreground="{StaticResource MutedBrush}"
                                           FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Vše" Tag="all" GroupName="filter" IsChecked="True" Click="Filter_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Zapnuto" Tag="on" GroupName="filter" Click="Filter_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Vypnuto" Tag="off" GroupName="filter" Click="Filter_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Doporučené" Tag="rec" GroupName="filter" Click="Filter_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Nové" Tag="new" GroupName="filter" Click="Filter_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Experimentální" Tag="exp" GroupName="filter" Click="Filter_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Nepodporované" Tag="unsup" GroupName="filter" Click="Filter_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="2" x:Name="RestartBanner" Visibility="Collapsed" Background="{StaticResource OrangeSoftBrush}"
                            BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,6,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Změny jsou provedeny. Pro jejich plný efekt je potřeba restartovat počítač."
                                       VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource OrangeBrush}" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Restartovat nyní" Padding="14,7"
                                    Margin="16,0,0,0" Click="Restart_Click"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="3" x:Name="TweakList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                             ItemTemplate="{StaticResource TweakTemplate}" ItemContainerStyle="{StaticResource PlainItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                             HorizontalContentAlignment="Stretch"
                             Padding="0,0,6,0">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource OrangeBrush}"
                                                   FontSize="12" FontWeight="Bold" Margin="2,14,0,8"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>

                <!-- Stránka: Údržba -->
                <ScrollViewer x:Name="PageMaintenance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24,28,28" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Údržba" FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/>

                        <WrapPanel Margin="0,0,0,16">
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Úklid" Tag="clean" GroupName="mtab" IsChecked="True" Click="MaintTab_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Aktualizace aplikací" Tag="update" GroupName="mtab" Click="MaintTab_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Odinstalace aplikací" Tag="uninstall" GroupName="mtab" Click="MaintTab_Click"/>
                            <RadioButton Style="{StaticResource ChipButton}" Margin="0,0,6,6" Content="Prohlížeče" Tag="browser" GroupName="mtab" Click="MaintTab_Click"/>
                        </WrapPanel>

                        <!-- Úklid -->
                        <StackPanel x:Name="MaintClean">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Úklid systému" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource SectionText}"
                                               Text="Jednorázové akce. Na rozdíl od optimalizací se nedají vrátit zpět (mažou se dočasné soubory, výpisy pádů, protokoly Windows, mezipaměť Windows Update, koš a mezipaměť DNS)."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="Vyčistit dočasné a systémové soubory" Click="CleanTemp_Click" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Vyprázdnit DNS cache" Click="FlushDns_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MaintenanceResult" Foreground="{StaticResource GreenBrush}" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Mezipaměť aplikací" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource SectionText}"
                                               Text="Smaže mezipaměť (cache) a protokoly aplikací a her: Discord, Steam, Slack, Teams, Epic Games a Fortnite, Ubisoft, Battle.net, EA, GOG, Spotify, VS Code, OBS a shadery grafických karet (NVIDIA, AMD, Intel, DirectX). Přihlášení, nastavení, hry ani stažená hudba se nemění. Po vyčištění shaderů může první spuštění hry chvíli trvat. Aplikace si mezipaměť časem vytvoří znovu."/>
                                    <Button Style="{StaticResource GhostButton}" Content="Vyčistit mezipaměť aplikací" HorizontalAlignment="Left" Click="CleanAppCaches_Click"/>
                                    <TextBlock x:Name="AppCacheResult" Foreground="{StaticResource GreenBrush}" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Aktualizace aplikací -->
                        <StackPanel x:Name="MaintUpdate" Visibility="Collapsed">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Aktualizace aplikací" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource SectionText}"
                                               Text="Používá Windows Package Manager (winget), který je součástí Windows 10 a 11. Aktualizují se jen aplikace, které winget zná."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="Zkontrolovat aktualizace" Click="CheckUpdates_Click" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Aktualizovat vše" Click="UpdateAll_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource GreenBrush}" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="UpdateList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Aktualizovat" Padding="14,6" VerticalAlignment="Center" Click="UpdateApp_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Odinstalace aplikací -->
                        <StackPanel x:Name="MaintUninstall" Visibility="Collapsed">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Odinstalace aplikací" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource SectionText}"
                                               Text="Seznam nainstalovaných programů. Odinstalace spustí odinstalátor dané aplikace a může zobrazit vlastní okno. Nedá se vrátit zpět."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Width="380" HorizontalAlignment="Left">
                                            <Grid>
                                                <TextBox x:Name="AppSearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                                         CaretBrush="{StaticResource TextBrush}" FontSize="13" Padding="14,9" TextChanged="AppSearchBox_TextChanged"/>
                                                <TextBlock x:Name="AppSearchPlaceholder" Text="Hledat aplikace…" Foreground="{StaticResource MutedBrush}"
                                                           FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Obnovit seznam" Margin="8,0,0,0" Click="RefreshApps_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="UninstallStatus" Foreground="{StaticResource GreenBrush}" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="AppList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Odinstalovat" Padding="14,6" VerticalAlignment="Center" Click="Uninstall_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Prohlížeče -->
                        <StackPanel x:Name="MaintBrowser" Visibility="Collapsed">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Vyčistit prohlížeče" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#2A1414" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="NEDOPORUČENO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SectionText}"
                                               Text="Smaže mezipaměť a cookies v prohlížečích Chrome, Edge, Brave, Opera, Vivaldi a Firefox. Nedoporučujeme to: po vyčištění se budeš muset znovu přihlásit na všech webech. Hesla, historie a záložky zůstanou. Prohlížeče musí být zavřené."/>
                                    <Button Style="{StaticResource GhostButton}" Content="Vyčistit prohlížeče" HorizontalAlignment="Left" Click="CleanBrowsers_Click"/>
                                    <TextBlock x:Name="BrowserResult" Foreground="{StaticResource GreenBrush}" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Stránka: Nastavení -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24,28,28" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Nastavení" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Pokročilý režim" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionText}"
                                           Text="Optimalizace, které nejsou určené pro tento počítač (například pro grafiku Intel, když máš NVIDIA), jsou při vypnutém režimu ztmavené se zámkem a nejdou zapnout. Se zapnutým pokročilým režimem u nich zůstane jen štítek Nepodporované a jdou zapnout po potvrzení. Používej jen, když víš, co děláš."/>
                                <CheckBox x:Name="AdvancedCheck" Content="Zapnout pokročilý režim" Foreground="{StaticResource TextBrush}" Click="Advanced_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bod obnovení systému" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionText}"
                                           Text="Před první změnou v každém spuštění se vytvoří bod obnovení Windows, ke kterému se můžeš kdykoli vrátit. Navíc si aplikace pamatuje původní hodnoty a vypnutím optimalizace je obnoví."/>
                                <CheckBox x:Name="AutoRestoreCheck" Content="Automaticky vytvořit bod obnovení před první změnou" Foreground="{StaticResource TextBrush}"
                                          Margin="0,0,0,12" Click="AutoRestore_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Vytvořit bod obnovení teď" HorizontalAlignment="Left" Click="CreateRestorePoint_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Tento počítač" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionText}"
                                           Text="Zjištěno při spuštění. Podle toho se určuje, které optimalizace jsou podporované a doporučené."/>
                                <TextBlock x:Name="SystemDetails" Foreground="{StaticResource TextBrush}" FontSize="13" LineHeight="22" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="O aplikaci" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionText}"
                                           Text="Gasbyn Optimizer upravuje jen nastavení, která jdou vždy vrátit. Záloha původních hodnot a záznam změn jsou v datové složce aplikace. FPS tester přibude v dalším vydání."/>
                                <Button Style="{StaticResource GhostButton}" Content="Otevřít datovou složku" HorizontalAlignment="Left" Click="OpenData_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Podmínky a podpora" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SectionText}"
                                           Text="Máš problém nebo nápad? Napiš nám na Discord server. Podmínky použití si můžeš znovu přečíst."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Content="Podmínky použití" Click="ShowTerms_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Discord server" Click="DiscordServer_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Hlášení problémů" Click="DiscordChat_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Překrytí při čekání (bod obnovení, hromadné změny) -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <StackPanel>
                    <Path x:Name="BusySpinner" Width="34" Height="34" Stretch="Uniform" Fill="{StaticResource OrangeBrush}"
                          HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="BusyText" Text="Čekejte…" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Height="6" BorderThickness="0"
                                 Foreground="{StaticResource OrangeBrush}" Background="{StaticResource Panel2Brush}"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
