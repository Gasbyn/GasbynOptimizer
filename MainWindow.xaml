<Window x:Class="GasbynOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gasbyn Optimizer"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0D"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0B0D"/>
        <SolidColorBrush x:Key="Panel" Color="#121216"/>
        <SolidColorBrush x:Key="Panel2" Color="#18181D"/>
        <SolidColorBrush x:Key="Border" Color="#29292F"/>
        <SolidColorBrush x:Key="TextMuted" Color="#92929A"/>
        <SolidColorBrush x:Key="Orange" Color="#FF6A00"/>
        <SolidColorBrush x:Key="OrangeSoft" Color="#2A160A"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A7A7AF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1D1D23"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#2A160A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Orange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="PageEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.22"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0F0F12" BorderBrush="#222228" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" Background="{StaticResource Orange}" CornerRadius="10">
                            <TextBlock Text="G" FontSize="23" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GASBYN" FontSize="17" FontWeight="Black" LetterSpacing="1"/>
                            <TextBlock Text="OPTIMIZER" FontSize="9" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" LetterSpacing="2"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="MAIN" Margin="4,34,0,8" FontSize="10" Foreground="#66666E" FontWeight="Bold" LetterSpacing="1.5"/>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource NavButton}" Content="⌂   Dashboard" Tag="Dashboard" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⚡   Tweaks" Tag="Tweaks" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="♲   Cleanup" Tag="Cleanup" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="↗   Startup" Tag="Startup" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▣   PC Info" Tag="PC Info" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Nav_Click"/>
                </StackPanel>

                <Border Grid.Row="3" Background="#17171B" BorderBrush="#29292F" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#48D597" VerticalAlignment="Center"/>
                            <TextBlock Text="  SYSTEM READY" FontSize="10" FontWeight="Bold" Foreground="#B9B9C0"/>
                        </StackPanel>
                        <TextBlock Text="Gasbyn Optimizer v0.1" Margin="0,8,0,0" FontSize="10" Foreground="#66666E"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="34,28,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Přehled systému a rychlé akce" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{StaticResource OrangeSoft}" BorderBrush="#4A2410" BorderThickness="1" CornerRadius="20" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#48D597" VerticalAlignment="Center"/>
                        <TextBlock Text="  ONLINE" FontSize="10" FontWeight="Bold" Foreground="#FFB27A"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ContentHost" Grid.Row="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform Y="8"/>
                </Grid.RenderTransform>

                <!-- Dashboard -->
                <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="24" Background="#151114">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="WELCOME BACK, GASBYN" Foreground="{StaticResource Orange}" FontSize="11" FontWeight="Bold" LetterSpacing="1.3"/>
                                    <TextBlock Text="Ready to optimize your PC?" FontSize="25" FontWeight="Bold" Margin="0,8,0,5"/>
                                    <TextBlock Text="Safe, reversible system tweaks designed for gaming and everyday use." Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="⚡  Quick Optimize" Click="QuickOptimize_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CpuValue" Text="—" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/>
                                    <TextBlock Text="Processor detected" Foreground="#696971" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0">
                                <StackPanel>
                                    <TextBlock Text="GPU" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GpuValue" Text="—" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/>
                                    <TextBlock Text="Graphics adapter" Foreground="#696971" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RamValue" Text="—" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/>
                                    <TextBlock Text="Installed memory" Foreground="#696971" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="QUICK ACTIONS" FontSize="12" FontWeight="Bold" Foreground="#B7B7BE" LetterSpacing="1"/>
                                    <Button Style="{StaticResource ActionButton}" Content="🧹  Scan for junk files" HorizontalAlignment="Left" Margin="0,16,0,0" Click="QuickCleanup_Click"/>
                                    <Button Style="{StaticResource NavButton}" Content="⚡  Open gaming tweaks" Margin="0,10,0,0" Tag="Tweaks" Click="Nav_Click"/>
                                    <Button Style="{StaticResource NavButton}" Content="↗  Review startup apps" Tag="Startup" Click="Nav_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="STATUS" FontSize="12" FontWeight="Bold" Foreground="#B7B7BE" LetterSpacing="1"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Ellipse Width="9" Height="9" Fill="#48D597" VerticalAlignment="Center"/>
                                        <TextBlock Text="  Optimizer ready" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="No system changes have been made yet." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="All future tweaks will be designed to be reversible." Foreground="#696971" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Other pages are generated by code-behind -->
                <ScrollViewer x:Name="SecondaryView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SecondaryContent"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
