<Window x:Class="GasbynOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gasbyn Optimizer"
        Width="1280" Height="800" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#08090B" Foreground="#F4F4F5"
        FontFamily="Segoe UI" ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121419"/>
        <SolidColorBrush x:Key="Border" Color="#24272E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#858A94"/>
        <SolidColorBrush x:Key="TextDim" Color="#5E636D"/>
        <SolidColorBrush x:Key="Orange" Color="#FF6A00"/>
        <SolidColorBrush x:Key="OrangeLight" Color="#FF9A52"/>
        <SolidColorBrush x:Key="OrangeSoft" Color="#21150E"/>
        <SolidColorBrush x:Key="Green" Color="#48D597"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#90959F"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="15,12"/><Setter Property="Margin" Value="0,3,0,3"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#17191E"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#21150E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="Effect" Value="{StaticResource CardShadow}"/></Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Orange}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionBorder" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBorder" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionBorder" Property="Opacity" Value="0.68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Storyboard x:Key="PageEnter"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="9" To="0" Duration="0:0:0.22"/></Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="242"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0D0E11" BorderBrush="#1E2127" BorderThickness="0,0,1,0">
            <Grid Margin="18,20,18,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0"><StackPanel Orientation="Horizontal"><Border Width="40" Height="40" Background="{StaticResource Orange}" CornerRadius="11"><TextBlock Text="G" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="GASBYN" FontSize="17" FontWeight="Black"/><TextBlock Text="OPTIMIZER" FontSize="9" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/></StackPanel></StackPanel><TextBlock Text="SAFE PERFORMANCE TOOLS" Margin="1,12,0,0" FontSize="9" Foreground="{StaticResource TextDim}" FontWeight="Bold"/></StackPanel>
                <TextBlock Grid.Row="1" Text="WORKSPACE" Margin="4,31,0,9" FontSize="9" Foreground="#5F646E" FontWeight="Bold"/>
                <StackPanel x:Name="NavPanel" Grid.Row="2"><Button Style="{StaticResource NavButton}" Content="⌂   Dashboard" Tag="Dashboard" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⚡   Tweaks" Tag="Tweaks" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="♲   Cleanup" Tag="Cleanup" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="↗   Startup" Tag="Startup" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="▣   PC Info" Tag="PC Info" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Nav_Click"/></StackPanel>
                <Border Grid.Row="3" Background="#121419" BorderBrush="#252830" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,18,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Green}" VerticalAlignment="Center"/><TextBlock Text="  SYSTEM READY" FontSize="9" FontWeight="Bold" Foreground="#B9BDC5"/></StackPanel><TextBlock Text="Gasbyn Optimizer  •  v0.1" Margin="0,8,0,0" FontSize="9" Foreground="{StaticResource TextDim}"/></StackPanel></Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="34,28,34,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="29" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Přehled systému a rychlé akce" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" FontSize="13"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource OrangeSoft}" BorderBrush="#4A2814" BorderThickness="1" CornerRadius="18" Padding="12,7"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center"/><TextBlock Text="  ONLINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OrangeLight}"/></StackPanel></Border></Grid>
            <Grid x:Name="ContentHost" Grid.Row="1" Opacity="0" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform Y="9"/></Grid.RenderTransform>
                <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <Border Style="{StaticResource Card}" Padding="25" Background="#151114"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WELCOME BACK, GASBYN" Foreground="{StaticResource Orange}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Your PC. Your performance." FontSize="25" FontWeight="Bold" Margin="0,8,0,5"/><TextBlock Text="Safe, reversible system tools built for gaming and everyday use." Foreground="{StaticResource TextMuted}" FontSize="13"/></StackPanel><Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="⚡  QUICK OPTIMIZE" Click="QuickOptimize_Click" VerticalAlignment="Center" Margin="20,0,0,0"/></Grid></Border>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="CpuValue" Text="—" FontSize="21" FontWeight="Bold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="PROCESSOR DETECTED" Foreground="{StaticResource TextDim}" FontSize="9" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="GPU" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="GpuValue" Text="—" FontSize="21" FontWeight="Bold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="GRAPHICS ADAPTER" Foreground="{StaticResource TextDim}" FontSize="9" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="RamValue" Text="—" FontSize="21" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="INSTALLED MEMORY" Foreground="{StaticResource TextDim}" FontSize="9" Margin="0,5,0,0"/></StackPanel></Border></Grid>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#B7BBC3"/><Button Style="{StaticResource ActionButton}" Content="🧹  SCAN FOR JUNK FILES" HorizontalAlignment="Left" Margin="0,16,0,0" Click="QuickCleanup_Click"/><Button Style="{StaticResource NavButton}" Content="⚡  Open gaming tweaks" Margin="0,9,0,0" Tag="Tweaks" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="↗  Review startup apps" Tag="Startup" Click="Nav_Click"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0"><StackPanel><TextBlock Text="SYSTEM STATUS" FontSize="11" FontWeight="Bold" Foreground="#B7BBC3"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Ellipse Width="9" Height="9" Fill="{StaticResource Green}" VerticalAlignment="Center"/><TextBlock Text="  Optimizer ready" FontWeight="SemiBold"/></StackPanel><TextBlock Text="No system changes have been made yet." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock Text="Scan → Backup → Apply → Verify → Restore" Foreground="{StaticResource TextDim}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="SecondaryView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SecondaryContent"/></ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
