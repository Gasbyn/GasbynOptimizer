<UserControl x:Class="GasbynOptimizer.Apps.AppsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#08090B" Foreground="#F4F4F5"
        FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121419"/>
        <SolidColorBrush x:Key="Panel2" Color="#0E1014"/>
        <SolidColorBrush x:Key="Border" Color="#24272E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#858A94"/>
        <SolidColorBrush x:Key="TextDim" Color="#5E636D"/>
        <SolidColorBrush x:Key="Orange" Color="#FF6A00"/>
        <SolidColorBrush x:Key="OrangeSoft" Color="#21150E"/>
        <SolidColorBrush x:Key="Green" Color="#48D597"/>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#FF6A00"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DarkAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#1B1E24"/><Setter Property="Foreground" Value="#D9DCE2"/>
        </Style>
        <Style x:Key="AppItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="#121419" BorderBrush="#24272E" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#21150E"/><Setter TargetName="B" Property="BorderBrush" Value="#70401E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#3B3F48"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel><TextBlock Text="APPS MANAGER" Foreground="{StaticResource Orange}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Installed applications" FontSize="27" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Inspect → Explain → Official Uninstall → Deep Scan → Select leftovers" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="CountText" Text="0 apps" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource Action}" Content="↻  SCAN APPS" Click="Scan_Click"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <TextBox x:Name="SearchBox" Height="38" Padding="12,8" Background="#111318" Foreground="#F4F4F5" BorderBrush="#24272E" BorderThickness="1" TextChanged="Search_TextChanged"/>
            <TextBlock IsHitTestVisible="False" Text="Hledat aplikaci, publishera nebo cestu…" Foreground="#5E636D" Margin="13,10,0,0"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="AppsList" Grid.Column="0" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource AppItem}" SelectionChanged="AppsList_SelectionChanged"/>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="#0E1014" BorderBrush="#24272E" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="APP CHECKER" Foreground="{StaticResource Orange}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="DetailName" Text="Vyber aplikaci" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailMeta" Text="" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>
                    <Border Background="#121419" BorderBrush="#24272E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="CO APLIKACE DĚLÁ" Foreground="#B7BBC3" FontWeight="Bold" FontSize="10"/><TextBlock x:Name="WhatText" Text="—" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Background="#121419" BorderBrush="#24272E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="CO MŮŽE PŘESTAT FUNGOVAT" Foreground="#B7BBC3" FontWeight="Bold" FontSize="10"/><TextBlock x:Name="ImpactText" Text="—" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Background="#121419" BorderBrush="#24272E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="INSTALLACE / UNINSTALL" Foreground="#B7BBC3" FontWeight="Bold" FontSize="10"/><TextBlock x:Name="InstallText" Text="—" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                    <TextBlock Text="DEEP UNINSTALL" Foreground="{StaticResource Orange}" FontSize="10" FontWeight="Bold" Margin="0,8,0,8"/>
                    <StackPanel Orientation="Horizontal"><Button Style="{StaticResource Action}" Content="OFFICIAL UNINSTALL" Click="OfficialUninstall_Click"/><Button Style="{StaticResource DarkAction}" Content="DEEP SCAN LEFTOVERS" Click="DeepScan_Click"/></StackPanel>
                    <TextBlock x:Name="DeepStatus" Text="Deep Scan nic nemaže. Výsledky se nejdříve zobrazí k ručnímu výběru." Foreground="{StaticResource TextDim}" FontSize="10" Margin="0,10,0,8" TextWrapping="Wrap"/>
                    <ListBox x:Name="LeftoversList" Background="Transparent" BorderThickness="0" MinHeight="120"/>
                    <Button x:Name="RemoveSelectedButton" Style="{StaticResource Action}" Content="REMOVE SELECTED LEFTOVERS" Click="RemoveSelected_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,10,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
