<Window x:Class="GasbynOptimizer.Cleanup.DeepCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Clean" Width="820" Height="620" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#08090B" Foreground="#F4F4F5">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121419"/>
        <SolidColorBrush x:Key="Border" Color="#24272E"/>
        <SolidColorBrush x:Key="Muted" Color="#858A94"/>
        <SolidColorBrush x:Key="Orange" Color="#FF6A00"/>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#FF6A00"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#191C21"/><Setter Property="Foreground" Value="#C8CBD1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="DEEP CLEAN" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Bezpečný výběrový úklid dočasných a cache souborů." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="NALEZENO" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalSizeText" Text="  —" Foreground="{StaticResource Orange}" FontSize="18" FontWeight="Bold" Margin="5,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Action}" Content="SCAN NOW" Click="Scan_Click"/>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ItemsPanel"/>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Text="Připraveno. Scan nic nemaže." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Secondary}" Content="CANCEL" Click="Close_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Action}" Content="CLEAN SELECTED" Click="Clean_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
