<UserControl x:Class="GasbynOptimizer.Startup.StartupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#08090B" Foreground="#F4F4F5"
        FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121419"/>
        <SolidColorBrush x:Key="Border" Color="#24272E"/>
        <SolidColorBrush x:Key="Muted" Color="#858A94"/>
        <SolidColorBrush x:Key="Orange" Color="#FF6A00"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF6A00"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1A1D22"/><Setter Property="Foreground" Value="#D7D9DE"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="STARTUP MANAGER" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Správa programů spouštěných při přihlášení — změny jsou vratné." Margin="0,4,0,0" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="↻  Refresh" Click="Refresh_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Open Startup Folder" Click="OpenFolder_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#151114" BorderBrush="#4A2814" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SummaryText" Text="Načítání…" FontWeight="SemiBold"/>
                    <TextBlock Text="Registry položky jsou upravovány pouze v uživatelském profilu. Systémové HKLM položky zůstávají chráněné." Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="Disable selected" Click="DisableSelected_Click"/>
            </Grid>
        </Border>
        <DataGrid Grid.Row="2" x:Name="StartupGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                  RowBackground="#121419" AlternatingRowBackground="#101216" Foreground="#E7E8EB" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#191B20"/><Setter Property="Foreground" Value="#9DA1AA"/><Setter Property="Padding" Value="10,9"/><Setter Property="BorderBrush" Value="#24272E"/></Style>
                <Style TargetType="DataGridRow"><Setter Property="Height" Value="42"/></Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.3*"/>
                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="2.6*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.8*"/>
                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="0.8*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="FooterText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Restore disabled" Click="RestoreSelected_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Close" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>