<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GasbynOptimizer</AssemblyName>
    <RootNamespace>GasbynOptimizer</RootNamespace>
    <Version>2.0.0.146</Version>

    <!-- Windows EXE version information. This identifies the project; it is not a digital signature. -->
    <Company>Gasbyn</Company>
    <Product>Gasbyn Optimizer</Product>
    <AssemblyTitle>Windows Optimization Tool</AssemblyTitle>
    <Description>Windows Optimization Tool</Description>
    <Copyright>Copyright © 2026 Gasbyn</Copyright>
    <Authors>Gasbyn</Authors>
    <RepositoryUrl>https://github.com/Gasbyn/GasbynOptimizer</RepositoryUrl>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>GasbynOptimizer.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\PowerPlans\*.pow" LogicalName="PowerPlans.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Logo.png" />
  </ItemGroup>

  <!-- Vygeneruje GasbynOptimizer.ico z Logo.png (jen na Windows, jen pokud ikona chybí). -->
  <Target Name="GenerateApplicationIcon" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)\GasbynOptimizer.ico')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\GenerateIcon.ps1&quot; -InputPng &quot;$(MSBuildProjectDirectory)\Logo.png&quot; -OutputIco &quot;$(MSBuildProjectDirectory)\GasbynOptimizer.ico&quot;" />
  </Target>

</Project>
